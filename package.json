{
  "name": "reelforge",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "web",
    "api",
    "packages/shared"
  ],
  "scripts": {
    "install": "npm run prisma:generate",
    "dev": "concurrently \"npm run dev --workspace web\" \"npm run dev:api\"",
    "dev:api": "vercel dev --listen 3000",
    "build": "npm run build --workspace packages/shared && npm run build --workspace web",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.5.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "concurrently": "^9.1.2",
    "prisma": "^6.5.0",
    "tsx": "^4.20.0",
    "typescript": "^5.6.3",
    "vercel": "^39.3.0"
  }
}
